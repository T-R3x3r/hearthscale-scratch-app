{
  "api": 4,
  "id": "scratch-board",
  "name": "Scratch Board",
  "version": "0.2.1",
  "description": "A board in the rail that shows the weather in Berlin.",
  "icon": "icon.svg",
  "license": "MIT",
  "payment": "free",
  "author": "T-R3x3r",
  "categories": [
    "utilities"
  ],
  "environment": {
    "kind": "process",
    "network": [
      "api.open-meteo.com"
    ]
  },
  "surfaces": [
    {
      "id": "board",
      "kind": "view",
      "title": "Board",
      "entry": "views/board.js",
      "placements": [
        "rail",
        "tab"
      ]
    }
  ],
  "permissions": [
    "clipboard-write"
  ],
  "examples": [
    "Show me the weather board."
  ]
}
